      "optional": true
    },
    "@deepseek-ai/dsh-api-session-controller": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-agent-preset": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
